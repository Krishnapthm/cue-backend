# Copy to .env and fill in the real values. Never commit .env.

# Supabase Postgres (direct connection).
# Replace [YOUR-PASSWORD] with the database password from:
#   Supabase dashboard > Project Settings > Database > Database password
# URL-encode the password if it contains @ : / ? # [ ] or %
#
# NOTE: this host is IPv6-only. It works on IPv6-capable networks. If you ever
# deploy somewhere IPv4-only, swap to the session pooler host instead:
#   postgresql+asyncpg://postgres.swxhkplzfptdklfwjgij:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.swxhkplzfptdklfwjgij.supabase.co:5432/postgres

# local | staging | production
ENVIRONMENT=local
