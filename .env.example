# Copy to .env and fill in the real values. Never commit .env.

# Supabase Postgres (direct connection).
# Replace [YOUR-PASSWORD] with the database password from:
#   Supabase dashboard > Project Settings > Database > Database password
# URL-encode the password if it contains @ : / ? # [ ] or %
#
# NOTE: this host is IPv6-only. It works on IPv6-capable networks. If you ever
# deploy somewhere IPv4-only, swap to the session pooler host instead:
#   postgresql+asyncpg://postgres.swxhkplzfptdklfwjgij:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.swxhkplzfptdklfwjgij.supabase.co:5432/postgres

# local | staging | production
ENVIRONMENT=local

# Browser origins allowed to call the API, as a JSON array. Native iOS and
# Android do not enforce CORS; Expo's web target does. Defaults to empty, so
# an unconfigured deployment permits nothing. Never a wildcard.
CORS_ALLOW_ORIGINS=["http://localhost:8081"]

# Firebase project id (Firebase console > Project Settings > General).
# Firebase ID tokens are verified against this as the `aud`/`iss` claim.
AUTH_FIREBASE_PROJECT_ID=your-firebase-project-id

# Swiggy MCP OAuth 2.1 + PKCE (https://mcp.swiggy.com/builders/docs/start/authenticate.md).
# Optional: leave unset for local dev that doesn't exercise the Swiggy link
# flow. Endpoints that need one of these return 503 (ProviderNotConfigured)
# rather than the app failing to start.
SWIGGY_CLIENT_ID=your-swiggy-client-id
# Our own callback URL, registered with Swiggy; must be reachable from the
# public internet and match exactly on both the authorize and token calls.
SWIGGY_REDIRECT_URI=https://api.cue.app/providers/swiggy/callback
# App deep link the callback redirects to once linking finishes.
SWIGGY_APP_CALLBACK_DEEP_LINK=cue://swiggy-link
# Fernet key (generate with `Fernet.generate_key()`) encrypting Swiggy
# access tokens and PKCE verifiers at rest.
SWIGGY_TOKEN_ENCRYPTION_KEY=your-fernet-key

# LangGraph agent model. `openai` | `anthropic` - the provider seam lives in
# app/agent/providers.py, so switching these two lines is the whole change.
AGENT_MODEL_PROVIDER=openai
# Required, no default: the deployment must state the model id explicitly.
AGENT_MODEL_NAME=gpt-5.4
# Provider API key, read by the langchain client directly (not via settings).
# Set ANTHROPIC_API_KEY instead when AGENT_MODEL_PROVIDER=anthropic.
OPENAI_API_KEY=your-openai-api-key

# Supabase project base URL (Supabase dashboard > Project Settings > API),
# used to build recipe-photo object URLs for the agent's vision parsing
# (app/agent/storage.py). Optional: leave unset for local dev that doesn't
# exercise recipe photo parsing.
AGENT_SUPABASE_URL=https://swxhkplzfptdklfwjgij.supabase.co
# Supabase Storage bucket that recipe photo uploads land in.
AGENT_RECIPE_IMAGE_BUCKET=recipe-images
